LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# 可选：SoCLaaS 使用 https://soclaas-api.comp.nus.edu.sg/v1/chat/completions
# LLM_PROVIDER=soclaas
# SOCLAAS_API_KEY=your-soclaas-api-key-here
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_MODEL=qwen3.8:27b
# SoCLaaS quick-start 默认值；可改成服务支持的其他 reasoning_effort。
# SOCLAAS_REASONING_EFFORT=none
# 网络请求超时/瞬时 429 或 5xx 重试配置（适用于所有 provider）。
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
# Flash 默认关闭 thinking 以减少回合延迟；需要深度思考时显式改为 enabled。
# LLM_THINKING_TYPE=enabled
