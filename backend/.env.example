LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# 可选：一次配置多个 DeepSeek 模型，之后直接在游戏会话侧栏切换。
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# 可选：SoCLaaS 使用 https://soclaas-api.comp.nus.edu.sg/v1/chat/completions
# LLM_PROVIDER=soclaas
# SOCLAAS_API_KEY=your-soclaas-api-key-here
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_MODEL=qwen3.8:27b
# SOCLAAS_MODELS=qwen3.8:27b,another-tool-capable-model
# 可选：指定模型选择器初始值；格式为 provider:model。
# LLM_DEFAULT_PROFILE=soclaas:qwen3.8:27b
# 参数由模型能力和任务类型自动决定；以下仅供旧式单模型接入兼容。
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=2
# 高级诊断覆盖：通常不需要设置。
# LLM_THINKING_TYPE=enabled
